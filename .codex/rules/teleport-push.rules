# The user authorizes normal pushes to this repository. Keep the destination
# explicit; do not allow arbitrary Git remotes or shell/publication wrappers.
prefix_rule(
    pattern = ["git", "push", "--", "https://github.com/vtjeng/teleport-contest.git"],
    decision = "allow",
    justification = "User-authorized pushes to vtjeng/teleport-contest for hosted validation and accepted publication.",
    match = [
        "git push -- https://github.com/vtjeng/teleport-contest.git HEAD:refs/heads/main",
        "git push -- https://github.com/vtjeng/teleport-contest.git HEAD:refs/heads/integration-checkpoint/candidate",
    ],
    not_match = [
        "git push origin main",
        "git push --force https://github.com/vtjeng/teleport-contest.git main",
        "git push --delete https://github.com/vtjeng/teleport-contest.git main",
        "git push -- https://github.com/other/repository.git main",
    ],
)
