  "hypothesis": "Spending a naturally earned skill slot must be undone by level loss without erasing practice, and regained slots must restore eligibility.",
  "expectedBehavior": "Healing21 practice eligible with19 slots, Basic with18 slots after spending; loss leaves0 slots and revokes Basic; regain yields1 slot and Unskilled21/20 eligibility.",
  "observedBehavior": "Four full C/JS matches. Normal enhance menus display19/18/0/1 slots and healing21 before/after spending and regain; JS asserts refund and practice retention.",
  "witness": {
    "kind": "public_recording",
    "scope": "Ordinary earned practice and normal enhance selection with debug practice bypass declined, then wizard-assisted loss/regain.",
    "limitations": [
      "Level loss/regain remains wizard-assisted.",
      "Refund-target first menu page displays0 slots but healing row is below that page; regain-target directly displays Unskilled21/20. JS verifies intermediate refund state.",
      "No multi-skill refund ordering, cap or natural level-drain history claim."
    ]
  },
