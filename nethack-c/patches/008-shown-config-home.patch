 /* ----------  END CONFIG FILE HANDLING ----------- */
 
+/* Recorder patch 008: show the reference recorder's config file path.
+ *
+ * fopen_config_file() has just opened $HOME/.nethackrc.  NetHack prints
+ * configfile[] in the options help (options.c:9471), in option errors
+ * (options.c:6815-6818, cfgfiles.c:1614) and in #saveoptions' prompt.  The
+ * judge's recorder ran with the HOME that docs/recording-environment.md
+ * gives; a local recorder runs with a temporary one.  When
+ * NETHACK_SHOWN_HOME is set, store the path the file would have had under
+ * it.  Only the name changes: the open stream still reads the local file.
+ * #saveoptions writes to the stored name, as the judge's recorder did;
+ * where that directory does not exist, its fopen() fails without a message.
+ *
+ * This function sits at the end of the file and its declaration shares a
+ * line with fopen_config_file()'s, so every upstream line keeps its number:
+ * the RNG log names the line of each call (patch 003).
+ */
+staticfn FILE *
+shown_configfile(FILE *fp)
+{
+    char shown[BUFSZ];
+    char *home = nh_getenv("NETHACK_SHOWN_HOME");
+
+    if (home && *home) {
+        Snprintf(shown, sizeof shown, "%s/%s", home, ".nethackrc");
+        set_configfile_name(shown);
+    }
+    return fp;
+}
+
 /*cfgfiles.c*/
 
