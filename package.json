{
  "name": "teleport-contest",
  "version": "1.0.0",
  "description": "The Teleport Coding Challenge — Port NetHack C to JavaScript",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-test-suite.mjs default",
    "test:mutation-runner": "node scripts/run-test-suite.mjs mutation-runner",
    "test:all": "node scripts/run-test-suite.mjs all",
    "check:duplicate-symbols": "node scripts/check-duplicate-symbols.mjs",
    "check:namespace-members": "node scripts/check-namespace-members.mjs",
    "check:relative-imports": "node scripts/check-relative-imports.mjs",
    "check:extcmds": "node scripts/generate-extcmds.mjs --check",
    "check:monsters": "node scripts/generate-monsters.mjs --check",
    "check:objects": "node scripts/generate-objects.mjs --check",
    "check:options": "node scripts/generate-options.mjs --check",
    "check:shtypes": "node scripts/generate-shtypes.mjs --check",
    "check:symbols": "node scripts/generate-symbol-data.mjs --check",
    "check:themerooms": "node scripts/generate-themeroom-data.mjs --check",
    "checkpoint": "node scripts/checkpoint-checks.mjs",
    "mutate": "node scripts/mutate-sites.mjs",
    "quality": "node scripts/quality-status.mjs",
    "score": "bash frozen/score.sh",
    "play": "echo 'Open index.html in a browser to play'"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
